        "path": "/api/v1/products/101/deduct-stock"
      },
      "response": {
        "body": {
          "content": {
            "id": "101",
            "remaining_stock": 13,
            "status": "DEDUCTED"
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    },
    {
